@article{deshmukh2026sil,
  title     = {Bifurcation structure of soliton self-injection locking in microresonators},
  author    = {Deshmukh, Savyaraj and Schneider, Tobias M. and Tikan, Alexey},
  journal   = {Optics Letters},
  volume    = {51},
  number    = {17},
  pages     = {4817--4820},
  year      = {2026},
  month     = {aug},
  publisher = {Optica Publishing Group},
  doi       = {10.1364/OL.608452},
  arxiv     = {2606.29921},
  eprint    = {2606.29921},
  archiveprefix = {arXiv},
  primaryclass = {physics.optics},
  url       = {https://doi.org/10.1364/OL.608452},
  html      = {https://opg.optica.org/ol/abstract.cfm?uri=ol-51-17-4817},
  bibtex_show = {true},
  selected  = {true},
  abbr      = {Opt. Lett.},
  abstract  = {Self-injection locking of a diode laser to a high-quality-factor microresonator provides access to compact, ultranarrow-linewidth lasers and facilitates dissipative Kerr soliton generation. We analyze the bifurcation structure of soliton self-injection locking in the weak-backscattering limit. The feedback produces soliton-number-dependent existence ranges for multi-soliton solutions in the free-laser detuning and feedback phase. We identify regions where only the single-soliton state exists and demonstrate dynamical access to this state through direct numerical simulations with prescribed parameter sweeps.}
}

@article{deshmukh2026soliton,
  title     = {Nonlinear periodic orbit solutions and their bifurcation structure at the origin of soliton hopping in coupled microresonators},
  author    = {Deshmukh, Savyaraj and Tusnin, Alexey and Tikan, Alexey and Kippenberg, Tobias J. and Schneider, Tobias M.},
  journal   = {Communications Physics},
  year      = {2026},
  arxiv     = {2508.09921},
  eprint    = {2508.09921},
  archiveprefix = {arXiv},
  primaryclass = {physics.optics},
  url       = {https://www.nature.com/articles/s42005-026-02623-6},
  html      = {https://www.nature.com/articles/s42005-026-02623-6},
  bibtex_show = {true},
  selected  = {true},
  abbr      = {Comm. Phys.},
  abstract  = {Soliton hopping, a dynamic process in which solitons periodically transfer between coupled resonators, is investigated using bifurcation analysis of nonlinear periodic orbit solutions. We reveal a fundamental distinction between dimer and trimer configurations: hopping arises from stable soliton branches in two-resonator systems, whereas in three-resonator systems it originates from unstable branches, substantially reducing the required pump power by an order of magnitude. Subcritical Hopf bifurcations of unstable equilibrium branches explain observed hysteresis and the coexistence of multiple attractors at the same parameter values, with implications for reliable frequency comb generation in integrated photonic systems.}
}

@article{gelash2025periodic,
  title     = {Periodic orbits underlying spatiotemporal chaos in the {Lugiato--Lefever} model},
  author    = {Gelash, Andrey and Deshmukh, Savyaraj and Shusharin, Aleksandr and Schneider, Tobias M. and Kippenberg, Tobias J.},
  year      = {2025},
  arxiv     = {2509.10283},
  eprint    = {2509.10283},
  archiveprefix = {arXiv},
  primaryclass = {nlin.PS},
  url       = {https://arxiv.org/abs/2509.10283},
  bibtex_show = {true},
  selected  = {true},
  abbr      = {arXiv},
  abstract  = {We identify periodic orbits called oscillating Turing rolls (OTR) in the Lugiato-Lefever model of optical cavities and elucidate their bifurcation structure, connecting continuous waves, Turing rolls, solitons, and breathers. These periodic orbits serve as elementary building blocks in the transition from stable Turing rolls to fully developed turbulent regimes. Spatiotemporal and temporal intermittency patterns are observed, where chaotic dynamics alternate with different OTR families. This framework provides new theoretical tools for understanding optical turbulence through dynamical systems analysis.},
  annotation = {*Equal contribution}
}
